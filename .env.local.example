# Run `pnpm env:setup` to generate .env.local with secure random secrets.
# @ink-memory/db embedded PostgreSQL
DATABASE_URL=postgres://ink_memory:<url-safe-password>@127.0.0.1:54329/ink-memory
INK_DATABASE_MODE=embedded-postgres
EMBEDDED_POSTGRES_DATA_DIR=~/.ink-memory/postgres
EMBEDDED_POSTGRES_PORT=54329
EMBEDDED_POSTGRES_SHARED_BUFFERS=96MB
EMBEDDED_POSTGRES_MAX_CONNECTIONS=50
POSTGRES_USER=ink_memory
POSTGRES_PASSWORD=<url-safe-password>
POSTGRES_DB=ink-memory
PGPOOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# Refine Admin authentication and same-origin protection
ADMIN_CONSOLE_ENABLED=true
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_ORIGIN_ALLOWLIST=http://localhost:3000

# Gateway key hashing and encrypted Provider credentials
GATEWAY_API_KEY_PEPPER=
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER_HOST_ALLOWLIST=
AI_PROVIDER_ALLOW_INSECURE_LOCALHOST=false
GATEWAY_MIN_RESERVE_MICROUSD=0
GATEWAY_MAX_BODY_BYTES=20971520
ARTIFACT_WORKSPACE_ROOT=/absolute/path/to/ink-dream-memory/backend/data/agent-workspace
ARTIFACT_PREVIEW_MAX_FILE_BYTES=8388608

# File storage is temporarily disabled; MinIO is not part of the base topology.
FILE_STORAGE_TYPE=disabled
FILE_STORAGE_PREFIX=uploads
