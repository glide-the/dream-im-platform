# Ink Memory PostgreSQL (required; no SQLite fallback)
DATABASE_URL=postgres://ink_memory:ink_memory@localhost:5433/ink-memory
# Alternatively omit DATABASE_URL and configure all PG* values.
PGHOST=localhost
PGPORT=5433
PGUSER=ink_memory
PGPASSWORD=ink_memory
PGDATABASE=ink-memory
PGPOOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# Refine Admin authentication and RBAC
ADMIN_CONSOLE_ENABLED=true
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_ORIGIN_ALLOWLIST=http://localhost:3000

# Model credentials and Gateway API key protection
GATEWAY_API_KEY_PEPPER=
# Exactly 32 bytes as canonical base64, or 64 hexadecimal characters.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER_HOST_ALLOWLIST=
AI_PROVIDER_ALLOW_INSECURE_LOCALHOST=false
GATEWAY_MIN_RESERVE_MICROUSD=0
GATEWAY_MAX_BODY_BYTES=20971520

# Container/runtime migration switch
RUN_DB_MIGRATIONS=true
