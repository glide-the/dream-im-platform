# Run `pnpm env:setup` to generate .env.local with secure random secrets.
# Ink Memory PostgreSQL
DATABASE_URL=postgres://ink_memory:ink_memory@localhost:5433/ink-memory
PGPOOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# Refine Admin authentication and same-origin protection
ADMIN_CONSOLE_ENABLED=true
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_ORIGIN_ALLOWLIST=http://localhost:3000

# Gateway key hashing and encrypted Provider credentials
GATEWAY_API_KEY_PEPPER=
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER_HOST_ALLOWLIST=
AI_PROVIDER_ALLOW_INSECURE_LOCALHOST=false
GATEWAY_MIN_RESERVE_MICROUSD=0
GATEWAY_MAX_BODY_BYTES=20971520

# File storage: local MinIO uses the S3 driver by default
FILE_STORAGE_TYPE=s3
FILE_STORAGE_PREFIX=uploads
BLOB_READ_WRITE_TOKEN=

# S3 / S3-compatible storage (used when FILE_STORAGE_TYPE=s3)
FILE_STORAGE_S3_BUCKET=ink-memory
FILE_STORAGE_S3_REGION=us-east-1
FILE_STORAGE_S3_ENDPOINT=http://localhost:9000
FILE_STORAGE_S3_FORCE_PATH_STYLE=true
FILE_STORAGE_S3_PUBLIC_BASE_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=ink_memory
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MINIO_USER=ink_memory
MINIO_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
