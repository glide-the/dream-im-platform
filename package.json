{
  "name": "ink-memory-admin",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "env:setup": "node scripts/setup-env.mjs",
    "env:check": "node scripts/setup-env.mjs --check",
    "gateway:provision-local-dream": "node scripts/provision-local-dream-gateway.mjs --apply",
    "product:provision-local-dream": "node scripts/provision-local-dream-product.mjs --apply",
    "plans:seed": "node scripts/seed-default-dream-plans.mjs --apply",
    "plans:check": "node scripts/seed-default-dream-plans.mjs",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:coverage": "vitest run --coverage --exclude \"**/*.integration.test.ts\"",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:data-migration:e2e": "node scripts/run-dream-data-migration-e2e.mjs",
    "test:all": "pnpm test:run && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:data:legacy": "node drizzle/data/legacy-43-plus-5.mjs",
    "db:data:subscriptions": "node drizzle/data/default-dream-plans.mjs",
    "db:push": "drizzle-kit push",
    "story:import": "node scripts/import-ink-dream-story-source.mjs",
    "docker:build": "cd docker && docker compose build",
    "docker:up": "cd docker && docker compose up -d --build",
    "docker:down": "cd docker && docker compose down",
    "docker:logs": "cd docker && docker compose logs -f ink-memory-admin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@aws-sdk/client-s3": "^3.981.0",
    "@aws-sdk/s3-request-presigner": "^3.981.0",
    "@refinedev/core": "5.0.12",
    "@refinedev/nextjs-router": "7.0.5",
    "@tanstack/react-query": "^5.90.20",
    "@vercel/blob": "^2.0.1",
    "drizzle-orm": "^0.45.1",
    "jose": "5.10.0",
    "next": "16.1.6",
    "openai": "7.4.0",
    "pg": "^8.13.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "8.4.39",
    "react-grab": "^0.1.50",
    "tailwindcss": "4.1.18",
    "typescript": "5.5.4",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
