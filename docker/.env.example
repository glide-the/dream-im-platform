# Run `pnpm env:setup` from the repository root to generate docker/.env.
APP_PORT=3000
NEXT_BUILD_CPUS=2
NEXT_BUILD_MAX_OLD_SPACE_MB=2048
POSTGRES_PORT=5433
POSTGRES_USER=ink_memory
POSTGRES_PASSWORD=
POSTGRES_DB=ink-memory
EMBEDDED_POSTGRES_SHARED_BUFFERS=96MB
EMBEDDED_POSTGRES_MAX_CONNECTIONS=50

ADMIN_CONSOLE_ENABLED=true
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_ORIGIN_ALLOWLIST=http://localhost:3000

# Unified Better Auth and Admin-owned Dream data service. Supply distinct
# limited-role DSNs and deployment origins through the secret platform.
BETTER_AUTH_URL=https://admin.example.com/api/auth
BETTER_AUTH_SECRET=
AUTH_DATABASE_URL=postgres://ink_auth:<role-password>@127.0.0.1:5432/ink-memory
ADMIN_CONTROL_DATABASE_URL=postgres://ink_auth_control:<role-password>@127.0.0.1:5432/ink-memory
DREAM_DATA_DATABASE_URL=postgres://ink_dream_data:<role-password>@127.0.0.1:5432/ink-memory
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_TRUSTED_ORIGINS=https://admin.example.com,https://dream.example.com
DREAM_API_RESOURCE=https://dream.example.com/api
AUTH_TOKEN_ENCRYPTION_KEY=
AUTH_DEVICE_CLIENT_ID=ink-dream-device
DREAM_DATA_SERVICE_CLIENTS=[{"id":"ink-dream-service","secret":"<server-only-secret>","origin":"https://dream.example.com","oauthClientId":"ink-dream-browser","redirectUri":"https://dream.example.com/auth/callback","backgroundScopes":["capabilities:read","resource-policy:read","resource-observer:write","connectors:sync","plugins:catalog","reflections:execute","story-confirmation:dispatch"]}]
DREAM_GATEWAY_CLIENT_BINDINGS=[{"service_client_id":"ink-dream-service","gateway_client_id":"<provisioned-gateway-client>","oauth_client_ids":["ink-dream-browser","ink-dream-device"]}]
AUTH_BROWSER_SESSION_TTL_SECONDS=2592000
AUTH_REFRESH_SKEW_SECONDS=30
AUTH_RUNTIME_DELEGATION_TTL_SECONDS=300
AUTH_RUNTIME_DELEGATION_MAX_TTL_SECONDS=3600
AUTH_REFLECTIONS_AUTHORITY_TTL_SECONDS=300
AUTH_REFLECTIONS_AUTHORITY_MAX_TTL_SECONDS=3600
AUTH_BCRYPT_COST=12
AUTH_MAX_BODY_BYTES=16384
AUTH_PGPOOL_MAX=10
DREAM_DATA_PGPOOL_MAX=10
DREAM_DATA_MAX_BODY_BYTES=1048576
DREAM_DOMAIN_CANONICAL_TIMEOUT_MS=10000
DREAM_DECK_POLICY_JSON=
DREAM_REFLECTION_REPORT_LIST_MAX_ROWS=100
DREAM_REFLECTIONS_LAUNCH_SNAPSHOT_MAX_BYTES=1048576
DREAM_REFLECTIONS_WORKSPACE_ROOT=/artifacts/reflections
DREAM_FRIENDSHIP_POLICY_JSON={"code_length":6,"lifetime_seconds":604800,"generation_attempts":64}
DREAM_CONFIRMATION_DISPATCH_LEASE_SECONDS=120
INK_WORKFLOW_TOKEN_SECRET=
DREAM_PREFLIGHT_TOKEN_TTL_SECONDS=300
DREAM_PREFLIGHT_MAX_INPUT_BYTES=65536
INK_DECK_HOST_COMPATIBLE=true
INK_CLAUDE_AGENT_CONTRACT_COMPATIBLE=true
INK_STORY_SCHEMA_COMPATIBLE=true
INK_DECK_RUNTIME_CONFIG_COMPATIBLE=true
DREAM_WORKFLOW_CONTEXT_MAX_ATTEMPTS=256
DREAM_CHAT_AUTO_TITLE_MAX_CHARACTERS=50
GATEWAY_IMAGE_INPUT_TOKEN_ESTIMATE=4784
GATEWAY_API_KEY_PEPPER=
GATEWAY_SUBJECT_JWT_ISSUER=ink-dream-memory
GATEWAY_SUBJECT_JWT_AUDIENCE=ink-memory-admin-gateway
PRODUCT_API_JWT_SECRET=
PRODUCT_API_JWT_ISSUER=ink-dream-memory
PRODUCT_API_JWT_AUDIENCE=ink-memory-product-api
PRODUCT_API_ORIGIN_ALLOWLIST=http://127.0.0.1:5173
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY_ID=
AI_PROVIDER_HOST_ALLOWLIST=
AI_PROVIDER_ACCOUNT_IDENTITY_PEPPER=
AI_PROVIDER_ALLOW_INSECURE_LOCALHOST=false
GATEWAY_MIN_RESERVE_MICROUSD=0
GATEWAY_MAX_BODY_BYTES=20971520
ARTIFACT_WORKSPACE_ROOT=/artifacts
ARTIFACT_PREVIEW_MAX_FILE_BYTES=8388608
DREAM_WORKSPACE_PLUGIN_POLICY_JSON={"story_workspace_adapter":{"package_name":"ink-dream-story","marketplace":"platform-builtin","resolved_version":"1.0.0"}}
RUN_DB_MIGRATIONS=false

# Optional managed-product overrides. Leave empty to use the pinned
# Codex/xAI/GitHub Copilot defaults shipped with this release.
INK_PROVIDER_CODEX_CLIENT_ID=
INK_PROVIDER_CODEX_SCOPES=
INK_PROVIDER_CODEX_USER_AGENT=
INK_PROVIDER_CODEX_INTEGRATION_ID=
INK_PROVIDER_CODEX_INTEGRATION_VERSION=
INK_PROVIDER_CODEX_MODEL_CATALOG_CLIENT_VERSION=
INK_PROVIDER_CODEX_MODELS_ENDPOINT=

INK_PROVIDER_XAI_CLIENT_ID=
INK_PROVIDER_XAI_SCOPES=
INK_PROVIDER_XAI_USER_AGENT=
INK_PROVIDER_XAI_ISSUER=
INK_PROVIDER_XAI_MODELS_ENDPOINT=

INK_PROVIDER_GITHUB_COPILOT_CLIENT_ID=
INK_PROVIDER_GITHUB_COPILOT_CLIENT_SECRET=
INK_PROVIDER_GITHUB_COPILOT_SCOPES=
INK_PROVIDER_GITHUB_COPILOT_USER_AGENT=
INK_PROVIDER_GITHUB_COPILOT_INTEGRATION_ID=
INK_PROVIDER_GITHUB_COPILOT_EDITOR_VERSION=
INK_PROVIDER_GITHUB_COPILOT_EDITOR_PLUGIN_VERSION=
INK_PROVIDER_GITHUB_COPILOT_API_VERSION=
INK_PROVIDER_GITHUB_COPILOT_MODELS_ENDPOINT=

# MinIO is intentionally absent. Choose vercel-blob or s3 only when storage is restored.
FILE_STORAGE_TYPE=disabled
FILE_STORAGE_PREFIX=uploads
# Admin-owned Story Workspace Runtime activation placement and frozen adapter policy.
DREAM_RUNTIME_ACTIVATION_POLICY_JSON='{"runtime_environment_id":"ink-local","runtime_pool_id":"ink-local","runtime_node_id":"local","distribution_mode":"local_persistent","deployment_tier":"local","policy_revision":"dream-launch/v1","materialization_key_scope":"dream-launch","session_creating_lease_seconds":30,"required_plugin_id":"ink-dream-story@platform-builtin","required_plugin_version":"1.0.0","required_source_type":"platform-builtin"}'
