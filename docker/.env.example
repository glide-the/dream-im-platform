# ============================================
# ai4sales-pwa-app Docker Environment
# ============================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# ============================================

# ---- Anthropic / Claude Agent ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ---- Exa Search ----
EXA_API_KEY=

# ---- Agent Settings ----
MAX_BUDGET_USD=0.5
MAX_TURNS=10
AGENT_CWD=./agent-workspaces

# ---- PostgreSQL ----
DATABASE_URL=

# ---- File Storage (S3) ----
FILE_STORAGE_TYPE=s3
FILE_STORAGE_PREFIX=uploads
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_REGION=
FILE_STORAGE_S3_ENDPOINT=
FILE_STORAGE_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- WeKnora Knowledge Base ----
WEKNORA_API_KEY=
WEKNORA_BASE_URL=https://weknora.fanmikeji.cn
WEKNORA_KNOWLEDGE_BASE_ID=

# ---- App Port (host mapping) ----
APP_PORT=3000
