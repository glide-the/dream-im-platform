# Run `pnpm env:setup` from the repository root to generate docker/.env.
APP_PORT=3000
POSTGRES_PORT=5433
POSTGRES_USER=ink_memory
POSTGRES_PASSWORD=
POSTGRES_DB=ink-memory

ADMIN_CONSOLE_ENABLED=true
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_ORIGIN_ALLOWLIST=http://localhost:3000

GATEWAY_API_KEY_PEPPER=
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER_HOST_ALLOWLIST=
AI_PROVIDER_ALLOW_INSECURE_LOCALHOST=false
GATEWAY_MIN_RESERVE_MICROUSD=0
GATEWAY_MAX_BODY_BYTES=20971520
RUN_DB_MIGRATIONS=true

# File storage: bundled MinIO uses the S3 driver by default
FILE_STORAGE_TYPE=s3
FILE_STORAGE_PREFIX=uploads
BLOB_READ_WRITE_TOKEN=
FILE_STORAGE_S3_BUCKET=ink-memory
FILE_STORAGE_S3_REGION=us-east-1
FILE_STORAGE_S3_ENDPOINT=http://minio:9000
FILE_STORAGE_S3_FORCE_PATH_STYLE=true
FILE_STORAGE_S3_PUBLIC_BASE_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=ink_memory
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MINIO_USER=ink_memory
MINIO_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
