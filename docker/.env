# Motia Service Environment Configuration
# Adapted from cgoinglove/better-chatbot

# === Core Application ===
# Motia automatically loads environment variables from .env files
API_URL="https://xnigaj-xtnawg.motiahub.com"
SAMPLE_EMAIL="test@test.com"

# === Database ===
# If you don't have PostgreSQL running locally, start it with: docker compose -f docker/compose.yml up -d postgres
# Default values work out-of-the-box with docker/compose.yml
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/vibesales

# PostgreSQL Docker Environment Variables (for compose)
# These defaults match docker/compose.yml for quick local development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vibesales



# === File Storage ===
# FILE_STORAGE_TYPE=s3 | vercel-blob (default: s3)
# FILE_STORAGE_PREFIX=uploads

# -- Vercel Blob example --
# Pull the token locally with `vercel env pull` when testing against Vercel Blob.
# FILE_STORAGE_TYPE=vercel-blob
# FILE_STORAGE_PREFIX=uploads
# BLOB_READ_WRITE_TOKEN=

# -- S3 --
# FILE_STORAGE_TYPE=s3
# FILE_STORAGE_PREFIX=uploads
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=
# Optional: Use when serving files via CDN/custom domain
# FILE_STORAGE_S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional: For S3-compatible endpoints (e.g., MinIO)
# FILE_STORAGE_S3_ENDPOINT=http://localhost:9000
# Optional: Force path-style URLs (1/true to enable)
# FILE_STORAGE_S3_FORCE_PATH_STYLE=1

# -- MinIO (local S3-compatible storage) --
# If you don't have MinIO running locally, start it with: docker compose -f docker/compose.yml up -d minio
# Default values work out-of-the-box with docker/compose.yml
# FILE_STORAGE_TYPE=s3
# FILE_STORAGE_S3_BUCKET=vibesales
# FILE_STORAGE_S3_REGION=us-east-1
# FILE_STORAGE_S3_ENDPOINT=http://localhost:9000
# FILE_STORAGE_S3_FORCE_PATH_STYLE=1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# MinIO Docker Environment Variables (for compose)
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=vibesales

# AWS Credentials (server only)
# The AWS SDK automatically discovers credentials in this order:
# 1) Environment variables below, 2) ~/.aws/credentials or AWS_PROFILE,
# 3) IAM role attached to the runtime (EC2/ECS/EKS/Lambda).
# You do NOT need to set these when using an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1

# === Vercel Deployment ===
# VERCEL_ENV=development | preview | production
