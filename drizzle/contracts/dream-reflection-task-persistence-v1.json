  "semantics": {
    "task_binding": "nullable historical service_client_id and auth_user_id; new or adopted execution binds exact service, OAuth subject, and canonical owner",
    "launch_snapshot": "nullable server-only bounded immutable JSON; never projected through OAuth task DTO or receipt/audit bodies",
