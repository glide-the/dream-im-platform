        "runtime_delegations_maximum_expiry_check": {
          "name": "runtime_delegations_maximum_expiry_check",
          "value": "\"identity\".\"runtime_delegations\".\"maximum_expires_at\" IS NULL OR \"identity\".\"runtime_delegations\".\"maximum_expires_at\" >= \"identity\".\"runtime_delegations\".\"expires_at\""
        },
        "runtime_delegations_creation_check": {
          "name": "runtime_delegations_creation_check",
          "value": "\"identity\".\"runtime_delegations\".\"request_id\" IS NULL OR (\"identity\".\"runtime_delegations\".\"oauth_client_id\" IS NOT NULL AND \"identity\".\"runtime_delegations\".\"input_sha256\" IS NOT NULL AND \"identity\".\"runtime_delegations\".\"input_sha256\" ~ '^[0-9a-f]{64}$' AND \"identity\".\"runtime_delegations\".\"token_ciphertext\" IS NOT NULL AND \"identity\".\"runtime_delegations\".\"maximum_expires_at\" IS NOT NULL)"
        },
        "runtime_delegations_purpose_check": {
          "name": "runtime_delegations_purpose_check",
          "value": "(\"identity\".\"runtime_delegations\".\"purpose\" IS NULL AND \"identity\".\"runtime_delegations\".\"editor_session_id\" IS NULL) OR (\"identity\".\"runtime_delegations\".\"purpose\" IS NOT NULL AND cardinality(\"identity\".\"runtime_delegations\".\"scopes\") > 0 AND array_position(\"identity\".\"runtime_delegations\".\"scopes\", NULL) IS NULL AND (\n    (\"identity\".\"runtime_delegations\".\"purpose\" = 'server-persistence' AND \"identity\".\"runtime_delegations\".\"editor_session_id\" IS NULL AND \"identity\".\"runtime_delegations\".\"gateway_api_key_id\" IS NULL AND \"identity\".\"runtime_delegations\".\"scopes\" <@ ARRAY['dream:read','dream:write']::text[]) OR\n    (\"identity\".\"runtime_delegations\".\"purpose\" = 'gateway-cli' AND \"identity\".\"runtime_delegations\".\"editor_session_id\" IS NULL AND \"identity\".\"runtime_delegations\".\"gateway_api_key_id\" IS NOT NULL AND \"identity\".\"runtime_delegations\".\"scopes\" <@ ARRAY['messages:create','messages:count_tokens','models:list']::text[]) OR\n    (\"identity\".\"runtime_delegations\".\"purpose\" = 'editor-stdio' AND \"identity\".\"runtime_delegations\".\"editor_session_id\" IS NOT NULL AND \"identity\".\"runtime_delegations\".\"gateway_api_key_id\" IS NULL AND \"identity\".\"runtime_delegations\".\"scopes\" <@ ARRAY['editor:read','editor:write']::text[])\n  ))"
        }
