{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "vitest/globals",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./app/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e-dream-business-b4e34a593ce9/types/**/*.ts",
    ".next-e2e-dream-business-b4e34a593ce9/dev/types/**/*.ts",
    ".next-e2e-gateway-sse-20260810/types/**/*.ts",
    ".next-e2e-gateway-sse-20260810/dev/types/**/*.ts",
    ".next-e2e-gateway-build-20260810/types/**/*.ts",
    ".next-e2e-gateway-build-20260810/dev/types/**/*.ts",
    ".next-e2e-dream-business-a3fd5bbf6b9b/types/**/*.ts",
    ".next-e2e-dream-business-a3fd5bbf6b9b/dev/types/**/*.ts",
    ".next-e2e-subscription-c195535f117d/types/**/*.ts",
    ".next-e2e-subscription-c195535f117d/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "agent-workspaces",
    "html"
  ]
}
