# [Input] Explicit __ADMIN_DOMAIN__, __ADMIN_BIND_HOST__, __ADMIN_PORT__, and __ADMIN_FORWARDED_PROTO__ from the host ingress configuration.
# [Output] Host nginx reverse proxy for the Admin/Gateway process started with pnpm local:stable.
# [Pos] Non-container SSH Admin proxy template in deploy/nginx/.
# [Sync] 2026-10-25: native loopback proxy, explicit ingress protocol, WebSocket upgrade and private Google callback logging.

map $http_upgrade $ink_admin_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __ADMIN_DOMAIN__;

    client_max_body_size 100m;
    access_log /var/log/nginx/ink-memory-admin-access.log;
    error_log /var/log/nginx/ink-memory-admin-error.log warn;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto __ADMIN_FORWARDED_PROTO__;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $ink_admin_connection_upgrade;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location = /api/auth/callback/google {
        proxy_pass http://__ADMIN_BIND_HOST__:__ADMIN_PORT__;
        proxy_next_upstream off;
        access_log off;
        error_log /var/log/nginx/ink-memory-admin-callback-error.log crit;
    }

    location / {
        proxy_pass http://__ADMIN_BIND_HOST__:__ADMIN_PORT__;
    }
}
