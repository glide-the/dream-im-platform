# [Input] AutoDL SSH endpoint and SeetaCloud public port mapping.
# [Output] Secret-free operator defaults for deploy/autodl-ssh/deploy.sh.
# [Pos] AutoDL direct-host release configuration example; runtime secrets stay in .env.
# [Sync] 2026-08-26: document the dedicated /root/ink-autodl/data PostgreSQL root.
# [Sync] 2026-08-28: split the Next.js and DB runtime packaging memory budgets.
# [Sync] 2026-09-17: keep public origins deployment-injected; no product domain is a script default.
# [Sync] 2026-09-16: require deployment-owned Dream service registration bound to the public callback.

AUTODL_SSH_HOST=connect.example.com
AUTODL_SSH_USER=root
AUTODL_SSH_PORT=22
# Optional when reusing an authenticated SSH control socket.
# AUTODL_SSH_CONTROL_PATH=/tmp/ink-autodl-ssh/control
AUTODL_APP_ROOT=/root/ink-autodl/admin
AUTODL_DATA_ROOT=/root/autodl-tmp/ink-memory
AUTODL_ADMIN_HOME=/root/ink-autodl/data
AUTODL_ADMIN_BIND_HOST=127.0.0.1
AUTODL_ADMIN_PORT=6008
AUTODL_ADMIN_SMOKE_PORT=16008
AUTODL_BUILD_CPUS=1
AUTODL_BUILD_MAX_OLD_SPACE_MB=1024
AUTODL_PACKAGE_MAX_OLD_SPACE_MB=384
# Set true only when the host cannot fit the existing Admin process and a Next.js build together.
# A failed build or candidate smoke restarts the previous release before returning an error.
AUTODL_STOP_ADMIN_DURING_BUILD=false
# Uses Next.js experimental.webpackMemoryOptimizations during the candidate build.
AUTODL_WEBPACK_MEMORY_OPTIMIZATIONS=false
# Optional checksum-verified tar.gz containing .next/ and packages/db/dist from
# a Linux x64 build of the exact source commit. The target still packages,
# smokes, migrates, activates and verifies the release itself.
# AUTODL_PREBUILT_NEXT_ARCHIVE=/absolute/path/to/admin-next-linux-x64.tar.gz
AUTODL_ADMIN_PUBLIC_ORIGIN=https://admin-tunnel.example.com:8443
AUTODL_DREAM_PUBLIC_ORIGIN=https://dream-tunnel.example.com:8443
# One-line JSON. Replace the placeholder with a generated server-only secret before prepare-env.
AUTODL_DREAM_DATA_SERVICE_CLIENTS=[{"id":"ink-dream-service","secret":"replace-me","origin":"https://dream-tunnel.example.com:8443","oauthClientId":"ink-dream-browser","redirectUri":"https://dream-tunnel.example.com:8443/auth/callback","backgroundScopes":["capabilities:read","resource-policy:read","resource-observer:write","connectors:sync","plugins:catalog","reflections:execute","story-confirmation:dispatch"]}]
